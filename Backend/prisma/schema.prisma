generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  ADMIN
  SALES
  PRODUCTION
  DISPATCH
  CUSTOMER
}

enum OrderStatus {
  DRAFT
  ORDER_CREATED
  IN_PROGRESS
  COMPLETE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Order {
  id                     String        @id
  orderNumber            String        @unique
  status                 OrderStatus   @default(ORDER_CREATED)
  fabric                 String
  quantity               Int?
  dueDate                String
  productionStartDate    String        @default("")
  width                  Float?
  height                 Float?
  gusset                 Float?
  zip                    String
  color                  String
  handle                 String
  print                  String
  notes                  String?
  customerName           String
  customerPhone          String
  customerAlternatePhone String?
  customerAddress        String
  customerCourierType    String
  customerCourierNotes   String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  designs                OrderDesign[]
  capacityReservations   OrderCapacityReservation[]

  @@map("orders")
}

model OrderCapacityReservation {
  id             String   @id @default(uuid())
  orderId        String
  productionDate String
  quantity       Int
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([productionDate])
  @@index([orderId])
  @@map("order_capacity_reservations")
}

model OrderDesign {
  id           String   @id @default(uuid())
  orderId      String
  sortOrder    Int
  fileName     String?
  notes        String?
  originalName String?
  storedName   String?
  mimeType     String?
  size         Int?
  path         String?
  url          String?
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_designs")
}
